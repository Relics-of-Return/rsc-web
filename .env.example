# Server-side only: address of the rsc-www API server (used by the BFF route
# handlers under app/api). Never expose this to the browser.
RSC_WWW_API_URL=http://127.0.0.1:8888

# Public site URL (used for metadata/canonical URLs)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Server-side only: a long random secret shared with rsc-www's config.json
# ("proxySecret"). With it, the register and login routes tell rsc-www the
# visitor's address, so its per-IP limits apply per visitor rather than to
# everyone at once (in production every request reaches rsc-www from Vercel,
# through the tunnel). Leave unset locally.
# RSC_WWW_PROXY_SECRET=

# Where the /wiki rewrite sends requests (the rsc-wiki app). Defaults to
# http://127.0.0.1:3010 for a local stack.
# RSC_WIKI_URL=https://wiki.relicsofreturn.com
